# ---------------------------------------------------------------------------------------------
# Match data is confidential (data terms): no video, ATD, homography, Smart Tagging or anything
# derived from them goes into git. Anything committed once stays in the history forever -- when
# in doubt, add it here first and take it out later.
# ---------------------------------------------------------------------------------------------

# -- match data ----------------------------------------------------------------------------------
# data/ is committed empty, with only its README. hackathon_dataset/ is the original download.
data/*
!data/README.md
hackathon_dataset/
# External matches from other games (public datasets), downloaded by script.
/external/

# Insurance in case data files land anywhere else in the tree.
*.mp4
*.mkv
*.avi
*_atd.txt
*_atd.xml
*_homography.csv
*_smart_tagging.xml
*.gzip
*.pl3container

# -- ground truth --------------------------------------------------------------------------------
# The public ground truth (evaluation/gt/*_possession_gt_public*) ships with the official repo and
# stays. Full-match files must never be committed.
*_possession_gt.csv
*_possession_gt_meta.json
*_possession_gt_reference.csv
possession_by_frame.pkl

# -- submissions and scores -------------------------------------------------------------------
# Our own submissions are full-match labels, regenerated by the code. The official baselines
# ship with the upstream repo and stay.
evaluation/results/*.csv
!evaluation/results/baseline_*.csv
evaluation/reports/
evaluation/scoreboard.csv
/submissions/
/logs/
*.log

# -- caches, features and models -----------------------------------------------------------------
# Derived from the match data and regenerable, so never committed.
/cache/
/features/
/outputs/
/runs/
/checkpoints/
/wandb/
/lightning_logs/
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.feather
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.png
*.jpg
*.jpeg

# -- cluster -------------------------------------------------------------------------------------
slurm-*.out
slurm-*.err
*.out
*.err
core.*
.cache/

# -- private notes -----------------------------------------------------------------------------
01_help.txt
claude_notes/
*.pdf

# -- editors and Python ------------------------------------------------------------------------
.idea/
.vscode/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.DS_Store

# -- local validation scripts ---------------------------------------------------------------------
# Tools for looking at our outputs next to the video and each other (not part of the pipeline).
scripts/validation/video_alignment.py
scripts/validation/compare_spells.py
scripts/validation/diff_segments.py

# -- teammate's vision clone ----------------------------------------------------------------------
# A separate clone of the challenge repo (own .git, own copy of the match data) holding the WASB
# ball detection; kept out of this repository entirely.
/vision/

# -- third-party code ------------------------------------------------------------------------------
# WASB-SBDT (nttcom, MIT), cloned at commit 923462c, with its pretrained weights. Not ours to commit.
/third_party/
